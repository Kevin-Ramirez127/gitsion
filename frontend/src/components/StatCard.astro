---
import Icon from './Icon.astro';

interface Props {
  label: string;
  value: string;
  hint?: string;
  icon: string;
  href?: string;
}

const { label, value, hint, icon, href } = Astro.props;
---

{href ? (
  <a class="stat-card is-link" href={href} aria-label={`${label}: ${value}`}>
    <div class="stat-label">
      <Icon name={icon} size={13} />
      {label}
    </div>
    <div class="stat-value">{value}</div>
    {hint && <div class="stat-hint">{hint}</div>}
  </a>
) : (
  <div class="stat-card">
    <div class="stat-label">
      <Icon name={icon} size={13} />
      {label}
    </div>
    <div class="stat-value">{value}</div>
    {hint && <div class="stat-hint">{hint}</div>}
  </div>
)}
