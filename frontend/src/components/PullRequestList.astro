---
import Icon from './Icon.astro';
import type { PullRequestEntry } from '../lib/collections';
import {
  absoluteTime,
  prStateLabel,
  relativeTime,
  repositoryPath,
} from '../lib/format';

interface Props {
  entries: PullRequestEntry[];
  showRepo?: boolean;
  emptyText?: string;
}

const {
  entries,
  showRepo = false,
  emptyText = 'No pull requests yet.',
} = Astro.props;
---

{entries.length > 0 ? (
  <ul class="issue-list">
    {entries.map(({ pr, repo }) => {
      const state = pr.draft ? 'draft' : pr.state;
      return (
        <li class="issue-item">
          <span class="issue-icon is-pull" aria-hidden="true">
            <Icon name="pull" size={14} />
          </span>
          <div class="issue-body">
            <a
              class="issue-title"
              href={pr.htmlUrl}
              target="_blank"
              rel="noreferrer noopener"
            >
              <span class="issue-number">#{pr.number}</span>
              {pr.title}
            </a>
            <div class="issue-meta">
              <span class={`badge badge-${state}`}>{prStateLabel(state)}</span>
              {showRepo && (
                <a class="issue-repo" href={repositoryPath(repo.owner.login, repo.name)}>
                  {repo.fullName}
                </a>
              )}
              <span title={absoluteTime(pr.createdAt)}>
                opened {relativeTime(pr.createdAt)} by {pr.author.login}
              </span>
              {pr.mergedAt && <span>merged {relativeTime(pr.mergedAt)}</span>}
              {!pr.mergedAt && pr.state === 'closed' && pr.closedAt && (
                <span>closed {relativeTime(pr.closedAt)}</span>
              )}
            </div>
            {(pr.headRef || pr.baseRef) && (
              <div class="pr-branches issue-branches">
                <Icon name="branch" size={12} />
                {pr.headRef && <code class="branch">{pr.headRef}</code>}
                <span>→</span>
                {pr.baseRef && <code class="branch">{pr.baseRef}</code>}
              </div>
            )}
          </div>
        </li>
      );
    })}
  </ul>
) : (
  <p class="empty-inline">{emptyText}</p>
)}
