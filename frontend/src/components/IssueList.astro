---
import Icon from './Icon.astro';
import type { IssueEntry } from '../lib/collections';
import { absoluteTime, relativeTime, repositoryPath } from '../lib/format';

interface Props {
  entries: IssueEntry[];
  showRepo?: boolean;
  emptyText?: string;
}

const {
  entries,
  showRepo = false,
  emptyText = 'No open issues. The issue tracker is clear.',
} = Astro.props;
---

{entries.length > 0 ? (
  <ul class="issue-list">
    {entries.map(({ issue, repo }) => (
      <li class="issue-item">
        <span class="issue-icon" aria-hidden="true">
          <Icon name="issue" size={14} />
        </span>
        <div class="issue-body">
          <a
            class="issue-title"
            href={issue.htmlUrl}
            target="_blank"
            rel="noreferrer noopener"
          >
            <span class="issue-number">#{issue.number}</span>
            {issue.title}
          </a>
          <div class="issue-meta">
            {issue.state === 'closed' && <span class="badge badge-closed">Closed</span>}
            {showRepo && (
              <a class="issue-repo" href={repositoryPath(repo.owner.login, repo.name)}>
                {repo.fullName}
              </a>
            )}
            <span title={absoluteTime(issue.createdAt)}>
              {issue.state === 'closed' && issue.closedAt
                ? `closed ${relativeTime(issue.closedAt)}`
                : `opened ${relativeTime(issue.createdAt)}`}
              {' by '}
              {issue.author.login}
            </span>
            {issue.comments > 0 && <span>{issue.comments} comments</span>}
          </div>
          {issue.labels.length > 0 && (
            <div class="issue-labels">
              {issue.labels.map((label) => (
                <span class="label">{label}</span>
              ))}
            </div>
          )}
        </div>
      </li>
    ))}
  </ul>
) : (
  <p class="empty-inline">{emptyText}</p>
)}
