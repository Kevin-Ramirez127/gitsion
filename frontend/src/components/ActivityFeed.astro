---
import ActivityItem from './ActivityItem.astro';
import { groupActivities, type Activity, type FeedView } from '../lib/activity';
import { relativeTime } from '../lib/format';

interface Props {
  activities: Activity[];
  view: FeedView;
}

const { activities, view } = Astro.props;

const todayUtc = new Date().toISOString().slice(0, 10);
const ACTIVE_PREVIEW = 5;
const STALE_PREVIEW = 1;

const groups = groupActivities(activities, view).map((group) => {
  // Project groups collapse when their latest activity predates today, or when
  // the project has more than five activities. Stale projects show only their
  // newest activity; busy current projects show the five newest. Person groups
  // stay fully expanded.
  const collapsible = view === 'project';
  const stale = group.latest.slice(0, 10) < todayUtc;
  const previewSize = collapsible
    ? stale
      ? STALE_PREVIEW
      : ACTIVE_PREVIEW
    : group.activities.length;
  const preview = group.activities.slice(0, previewSize);
  const rest = group.activities.slice(preview.length);

  return { ...group, preview, rest };
});
---

<div class="feed">
  {groups.map((group, index) => (
    <section class="feed-group" aria-labelledby={`feed-group-${index}`}>
      <header class="feed-group-head">
        <div class="feed-group-id">
          <img
            class="feed-group-avatar"
            src={group.avatarUrl}
            alt=""
            width="28"
            height="28"
            loading="lazy"
            decoding="async"
          />
          <a
            class="feed-group-name"
            id={`feed-group-${index}`}
            href={group.href}
            target={view === 'user' ? '_blank' : undefined}
            rel={view === 'user' ? 'noreferrer noopener' : undefined}
          >
            {group.label}
          </a>
        </div>
        <span class="feed-group-meta">
          {group.activities.length} {group.activities.length === 1 ? 'activity' : 'activities'}
          · latest {relativeTime(group.latest)}
        </span>
      </header>

      <ol class="feed-list">
        {group.preview.map((activity) => (
          <ActivityItem activity={activity} view={view} />
        ))}
      </ol>

      {group.rest.length > 0 && (
        <details class="feed-rest">
          <summary class="feed-show-more">
            <span class="feed-show-more-label is-closed">Show more</span>
            <span class="feed-show-more-label is-open">Show less</span>
            <span class="feed-show-more-count">+{group.rest.length}</span>
          </summary>
          <ol class="feed-list feed-list-rest">
            {group.rest.map((activity) => (
              <ActivityItem activity={activity} view={view} />
            ))}
          </ol>
        </details>
      )}
    </section>
  ))}
</div>
