---
import Icon from './Icon.astro';
import type { OwnerSummary } from '../lib/types';

interface Props {
  owners: OwnerSummary[];
  activeOwner?: string;
  total: number;
}

const { owners, activeOwner = '', total } = Astro.props;
const active = activeOwner.toLowerCase();
---

{owners.length > 0 && (
  <nav class="owner-filter" aria-label="Filter repositories by owner">
    <span class="owner-filter-label">
      <Icon name="users" size={13} /> Owners
    </span>
    <a class:list={['chip', { 'is-active': !active }]} href="/">
      All
      <span class="chip-count">{total}</span>
    </a>
    {owners.map((owner) => (
      <a
        class:list={['chip', { 'is-active': active === owner.login.toLowerCase() }]}
        href={`/?owner=${encodeURIComponent(owner.login)}`}
        aria-current={active === owner.login.toLowerCase() ? 'page' : undefined}
      >
        <img class="chip-avatar" src={owner.avatarUrl} alt="" width="20" height="20" loading="eager" decoding="async" />
        {owner.login}
        <span class="chip-count">{owner.repoCount}</span>
      </a>
    ))}
  </nav>
)}
