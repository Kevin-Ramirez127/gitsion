---
import Icon from './Icon.astro';

interface Props {
  title: string;
  icon?: string;
  flush?: boolean;
}

const { title, icon, flush = false } = Astro.props;
---

<section class="panel">
  <header class="panel-head">
    <h2 class="panel-title">
      {icon && <Icon name={icon} size={14} />}
      {title}
    </h2>
    <slot name="action" />
  </header>
  <div class:list={['panel-body', { 'is-flush': flush }]}>
    <slot />
  </div>
</section>
