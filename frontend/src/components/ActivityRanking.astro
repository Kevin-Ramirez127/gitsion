---
import type { RepositoryActivityCount } from '../lib/activity';
import { plainNumber, plural } from '../lib/format';

interface Props {
  ranking: RepositoryActivityCount[];
  selectedRepository: string;
  hrefFor: (fullName: string) => string;
  clearHref: string;
}

const { ranking, selectedRepository, hrefFor, clearHref } = Astro.props;
const entries = ranking.slice(0, 5);
const maximum = entries[0]?.count ?? 1;
---

{(entries.length > 0 || selectedRepository) && (
  <details class="filter-section activity-ranking" data-collapsible="ranking">
    <summary class="filter-summary">
      <span class="filter-summary-title" id="activity-ranking-title">Captured activity by repository</span>
      <span class="filter-summary-note">
        {selectedRepository
          ? `Filtered: ${selectedRepository}`
          : ranking.length > 5
            ? `Top 5 of ${plainNumber(ranking.length)} repositories`
            : 'Captured activities'}
      </span>
      <span class="filter-toggle" aria-hidden="true"></span>
    </summary>

    <div class="activity-ranking-body">
      {entries.length > 0 && (
        <ol class="activity-ranking-list">
          {entries.map((entry, index) => {
            const selected = entry.fullName.toLowerCase() === selectedRepository.toLowerCase();
            return (
              <li>
                <a
                  class:list={['activity-ranking-link', { 'is-active': selected }]}
                  href={hrefFor(entry.fullName)}
                  aria-current={selected ? 'true' : undefined}
                  aria-label={`${selected ? 'Clear filter for' : 'Filter feed by'} ${entry.fullName}, ${plainNumber(entry.count)} captured ${plural(entry.count, 'activity', 'activities')}`}
                >
                  <span class="ranking-position" aria-hidden="true">{index + 1}</span>
                  <span class="ranking-repository">{entry.fullName}</span>
                  <span class="ranking-track" aria-hidden="true">
                    <span class="ranking-bar" style={`width: ${(entry.count / maximum) * 100}%`}></span>
                  </span>
                  <span class="ranking-value" aria-hidden="true">{plainNumber(entry.count)}</span>
                </a>
              </li>
            );
          })}
        </ol>
      )}

      {selectedRepository && (
        <p class="ranking-selection">
          <span>Showing <strong>{selectedRepository}</strong></span>
          <a href={clearHref}>Clear repository filter</a>
        </p>
      )}
      <p class="ranking-caption">Counts combine captured pushes with the latest state of each pull request or open issue in the selected period. Coverage may be incomplete; counts do not measure productivity. Select a repository to filter the feed.</p>
    </div>
  </details>
)}

<style>
  .activity-ranking-body {
    padding-bottom: 16px;
  }

  .activity-ranking-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .activity-ranking-list li {
    border-bottom: 1px solid var(--rule-soft);
  }

  .activity-ranking-link {
    display: grid;
    grid-template-columns: 22px minmax(0, 2fr) minmax(0, 3fr) minmax(28px, max-content);
    align-items: center;
    gap: 12px;
    min-height: 48px;
    padding: 10px 8px;
    color: var(--text);
    font-size: 13px;
  }

  .activity-ranking-link:hover,
  .activity-ranking-link:focus-visible {
    background: var(--panel-hover);
  }

  .activity-ranking-link:hover .ranking-repository,
  .activity-ranking-link:focus-visible .ranking-repository {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .activity-ranking-link.is-active {
    background: var(--accent-soft);
    box-shadow: inset 3px 0 0 var(--accent);
  }

  .ranking-position,
  .ranking-value {
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
  }

  .ranking-position {
    color: var(--faint);
    font-size: 11px;
  }

  .ranking-repository {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .ranking-track {
    height: 10px;
    background: var(--rule-soft);
  }

  .ranking-bar {
    display: block;
    height: 100%;
    background: var(--accent);
  }

  .ranking-value {
    text-align: right;
  }

  .ranking-caption {
    margin-top: 10px;
    color: var(--faint);
    font-size: 11px;
  }

  .ranking-selection {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin-top: 12px;
    font-size: 12px;
    overflow-wrap: anywhere;
  }

  .ranking-selection a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 560px) {
    .activity-ranking-link {
      grid-template-columns: 20px minmax(0, 1fr) auto;
      gap: 8px 10px;
    }

    .ranking-position {
      grid-column: 1;
      grid-row: 1 / 3;
      align-self: start;
    }

    .ranking-repository {
      grid-column: 2;
      grid-row: 1;
    }

    .ranking-value {
      grid-column: 3;
      grid-row: 1;
    }

    .ranking-track {
      grid-column: 2 / -1;
      grid-row: 2;
    }
  }
</style>
