---
import '../styles/global.css';
import { getSiteConfig, getThemeColor, getThemeStyle } from '../lib/config';
import { buildPageSeo, type SeoInput } from '../lib/seo';

interface Props {
  seo?: SeoInput;
}

const site = getSiteConfig();
const pathname = Astro.url.pathname;
const seo = buildPageSeo(
  Astro.props.seo ?? {
    title: site.title,
    description: site.description,
    route: pathname,
    indexable: pathname === '/',
  },
  Astro.url,
  Astro.request.headers,
);

// Reinforce the meta robots directive for crawlers that inspect headers.
if (seo.noindex) {
  Astro.response.headers.set('X-Robots-Tag', seo.robots);
}

const isAdmin = Astro.locals.isAdmin;
const writesEnabled = Astro.locals.writesEnabled;
const isHome = pathname === '/';
const theme = Astro.cookies.get('gitsion_theme')?.value === 'light' ? 'light' : 'dark';
const nextTheme = theme === 'dark' ? 'light' : 'dark';
const themeColor = getThemeColor(theme);
const themeStyle = getThemeStyle();
---

<!doctype html>
<html lang="en" data-theme={theme} style={themeStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <Fragment set:html={seo.head} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label={`${site.name} dashboard`}>
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="6" cy="6" r="2.5"></circle>
              <circle cx="6" cy="18" r="2.5"></circle>
              <circle cx="18" cy="8" r="2.5"></circle>
              <path d="M6 8.5v7"></path>
              <path d="M18 10.5c0 3-2.2 4.5-5 4.5H8"></path>
            </svg>
          </span>
          <span>{site.name}</span>
        </a>
        <nav class="site-nav" aria-label="Primary">
          <a class:list={['site-nav-link', { 'is-active': pathname === '/' }]} href="/">
            Activity
          </a>
          <a class:list={['site-nav-link', { 'is-active': pathname === '/issues' }]} href="/issues">
            Issues
          </a>
          <a class:list={['site-nav-link', { 'is-active': pathname === '/pulls' }]} href="/pulls">
            Pull requests
          </a>
        </nav>
        <div class="header-actions">
          <span class="header-note">{site.tagline}</span>
          <button
            class="theme-toggle"
            type="button"
            data-theme-toggle
            aria-label={`Switch to ${nextTheme} mode`}
            title={`Switch to ${nextTheme} mode`}
          >
            <span class="theme-toggle-label" data-theme-label>
              {theme === 'dark' ? 'Dark' : 'Light'}
            </span>
            <span class="theme-toggle-track" aria-hidden="true">
              <span class="theme-toggle-thumb"></span>
            </span>
          </button>
          {!isHome && (
            <a class="header-note" href="/admin">
              {isAdmin ? 'Admin' : writesEnabled ? 'Admin sign in' : 'Read-only'}
            </a>
          )}
        </div>
      </div>
    </header>

    <main id="main" class="container page">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <span>{site.name} · public repository activity</span>
      </div>
    </footer>

    <script src="/theme.js" defer></script>
    <script src="/app.js" defer></script>
  </body>
</html>
