---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'gitsion · GitHub activity feed',
  description = 'A newest-first feed of pushes, pull requests and issues across the GitHub repositories you track.',
} = Astro.props;

const isAdmin = Astro.locals.isAdmin;
const writesEnabled = Astro.locals.writesEnabled;
const isHome = Astro.url.pathname === '/';
const theme = Astro.cookies.get('gitsion_theme')?.value === 'light' ? 'light' : 'dark';
const nextTheme = theme === 'dark' ? 'light' : 'dark';
const themeColor = theme === 'dark' ? '#0b0b0b' : '#f2f0ea';
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="gitsion dashboard">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="6" cy="6" r="2.5"></circle>
              <circle cx="6" cy="18" r="2.5"></circle>
              <circle cx="18" cy="8" r="2.5"></circle>
              <path d="M6 8.5v7"></path>
              <path d="M18 10.5c0 3-2.2 4.5-5 4.5H8"></path>
            </svg>
          </span>
          <span>gitsion</span>
        </a>
        <div class="header-actions">
          <span class="header-note">GitHub activity feed</span>
          <button
            class="theme-toggle"
            type="button"
            data-theme-toggle
            aria-label={`Switch to ${nextTheme} mode`}
            title={`Switch to ${nextTheme} mode`}
          >
            <span class="theme-toggle-label" data-theme-label>
              {theme === 'dark' ? 'Dark' : 'Light'}
            </span>
            <span class="theme-toggle-track" aria-hidden="true">
              <span class="theme-toggle-thumb"></span>
            </span>
          </button>
          {!isHome && (
            <a class="header-note" href="/admin">
              {isAdmin ? 'Admin' : writesEnabled ? 'Admin sign in' : 'Read-only'}
            </a>
          )}
        </div>
      </div>
    </header>

    <main id="main" class="container page">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <span>gitsion · public repository activity</span>
      </div>
    </footer>

    <script src="/theme.js" defer></script>
    <script src="/app.js" defer></script>
  </body>
</html>
