---
import Layout from '../layouts/Layout.astro';
import ActivityFeed from '../components/ActivityFeed.astro';
import AddRepoForm from '../components/AddRepoForm.astro';
import EmptyState from '../components/EmptyState.astro';
import Flash from '../components/Flash.astro';
import Icon from '../components/Icon.astro';
import OwnerChips from '../components/OwnerChips.astro';
import StatCard from '../components/StatCard.astro';
import { buildActivityFeed, FEED_PAGE_SIZE, type ActivityKind, type FeedView } from '../lib/activity';
import { ApiError, listOwners, listRepositories } from '../lib/backend';
import { plainNumber, relativeTime } from '../lib/format';
import type { OwnerSummary, Repository } from '../lib/types';

const searchParams = Astro.url.searchParams;
const ownerFilter = (searchParams.get('owner') ?? '').trim();
const okMessage = searchParams.get('ok');
const errorMessage = searchParams.get('error');
const showAll = searchParams.get('show') === 'all';
const view: FeedView = searchParams.get('view') === 'user' ? 'user' : 'project';

const validKinds: ActivityKind[] = ['push', 'pull', 'issue'];
const selectedKinds = new Set<ActivityKind>(
  searchParams
    .getAll('kind')
    .filter((value): value is ActivityKind => validKinds.includes(value as ActivityKind)),
);
const requestedLabels = searchParams.getAll('label');

let repos: Repository[] = [];
let owners: OwnerSummary[] = [];
let loadError = '';

try {
  [repos, owners] = await Promise.all([
    listRepositories(ownerFilter || undefined),
    listOwners(),
  ]);
} catch (error) {
  loadError =
    error instanceof ApiError
      ? error.message
      : 'Could not reach the gitsion backend.';
}

const totalIssues = repos.reduce((total, repo) => total + repo.issues.length, 0);
const openLatestPrs = repos.filter(
  (repo) => repo.latestPr?.state === 'open' && !repo.latestPr.draft,
).length;
const lastSync = repos.reduce<string>((latest, repo) => {
  if (!repo.lastSyncedAt) return latest;
  if (!latest) return repo.lastSyncedAt;
  return new Date(repo.lastSyncedAt) > new Date(latest) ? repo.lastSyncedAt : latest;
}, '');
const activeOwner =
  owners.find((owner) => owner.login.toLowerCase() === ownerFilter.toLowerCase())?.login ??
  ownerFilter;
const totalTracked = owners.reduce((total, owner) => total + owner.repoCount, 0);

const allActivities = buildActivityFeed(repos);

const availableLabels = [
  ...new Set(repos.flatMap((repo) => repo.issues.flatMap((issue) => issue.labels))),
].sort((a, b) => a.localeCompare(b));
const availableLabelSet = new Set(availableLabels);
const selectedLabels = new Set(requestedLabels.filter((label) => availableLabelSet.has(label)));

const kindCounts: Record<ActivityKind, number> = { push: 0, pull: 0, issue: 0 };
const labelCounts = new Map<string, number>();

for (const activity of allActivities) {
  kindCounts[activity.kind] += 1;

  if (activity.kind === 'issue') {
    for (const label of new Set(activity.labels ?? [])) {
      labelCounts.set(label, (labelCounts.get(label) ?? 0) + 1);
    }
  }
}

const activities = allActivities.filter((activity) => {
  if (selectedKinds.size > 0 && !selectedKinds.has(activity.kind)) return false;
  if (selectedLabels.size > 0) {
    if (activity.kind !== 'issue') return false;
    if (!(activity.labels ?? []).some((label) => selectedLabels.has(label))) return false;
  }
  return true;
});

const visibleActivities = showAll ? activities : activities.slice(0, FEED_PAGE_SIZE);
const truncated = !showAll && activities.length > FEED_PAGE_SIZE;
const latestActivity = activities[0];
const hasFilters = selectedKinds.size > 0 || selectedLabels.size > 0;
const activitySummary = hasFilters
  ? `${plainNumber(activities.length)} of ${plainNumber(allActivities.length)} activities`
  : `${plainNumber(activities.length)} ${activities.length === 1 ? 'activity' : 'activities'}`;

interface FeedQuery {
  owner: string;
  view: FeedView;
  kinds: ActivityKind[];
  labels: string[];
  showAll: boolean;
}

function feedQuery(overrides: Partial<FeedQuery> = {}): string {
  const owner = overrides.owner ?? ownerFilter;
  const nextView = overrides.view ?? view;
  const kinds = overrides.kinds ?? [...selectedKinds];
  const labels = overrides.labels ?? [...selectedLabels];
  const all = overrides.showAll ?? showAll;

  const params = new URLSearchParams();
  if (owner) params.set('owner', owner);
  if (nextView === 'user') params.set('view', 'user');
  for (const kind of kinds) params.append('kind', kind);
  for (const label of labels) params.append('label', label);
  if (all) params.set('show', 'all');

  const query = params.toString();
  return query ? `/?${query}` : '/';
}

function kindHref(kind: ActivityKind | null): string {
  if (!kind) return feedQuery({ kinds: [] });
  const next = new Set(selectedKinds);
  if (next.has(kind)) {
    next.delete(kind);
  } else {
    next.add(kind);
  }
  if (next.size === validKinds.length) next.clear();
  return feedQuery({ kinds: [...next] });
}

function labelHref(label: string): string {
  const next = new Set(selectedLabels);
  if (next.has(label)) {
    next.delete(label);
  } else {
    next.add(label);
  }
  return feedQuery({ labels: [...next] });
}
---

<Layout>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">
        <Icon name="commit" size={13} /> Activity feed
      </p>
      <h1>
        Everything that moved,<br />
        <em>newest first.</em>
      </h1>
      <p class="lede">
        Pushes, pull requests and issues from the repositories you track, gathered into one
        calm feed. Data is pulled from the public GitHub API and cached in MongoDB.
      </p>
    </div>
    <div class="hero-aside">
      <AddRepoForm />
    </div>
  </section>

  {okMessage && <Flash kind="success" message={okMessage} />}
  {errorMessage && <Flash kind="error" message={errorMessage} />}

  {loadError && (
    <div class="banner" role="alert">
      <Icon name="alert" size={18} />
      <div>
        <strong>Could not load the dashboard</strong>
        <p>{loadError}</p>
      </div>
    </div>
  )}

  <div id="dashboard">
  <section class="stats" aria-label="Dashboard summary">
    <StatCard
      label="Activities"
      value={plainNumber(allActivities.length)}
      hint="pushes, pull requests & issues"
      icon="commit"
    />
    <StatCard
      label="Repositories"
      value={plainNumber(repos.length)}
      hint={
        ownerFilter
          ? `filtered by ${activeOwner}`
          : lastSync
            ? `last sync ${relativeTime(lastSync)}`
            : 'tracked repositories'
      }
      icon="repo"
    />
    <StatCard
      label="Open issues"
      value={plainNumber(totalIssues)}
      hint="up to 25 per repository"
      icon="issue"
    />
    <StatCard
      label="Repos with open PR"
      value={plainNumber(openLatestPrs)}
      hint="latest PR per repository"
      icon="pull"
    />
  </section>

  <OwnerChips owners={owners} activeOwner={activeOwner} total={totalTracked} />

  {repos.length > 0 && (
    <section class="filters" aria-labelledby="filters-title">
      <div class="filters-head">
        <h2 class="filters-title" id="filters-title">Filter feed</h2>
        {hasFilters ? (
          <a class="filters-clear" href={feedQuery({ kinds: [], labels: [] })}>
            Clear filters
          </a>
        ) : (
          <span class="filters-status">{activitySummary}</span>
        )}
      </div>

      <div class="filter-row">
        <span class="filter-label">View</span>
        <a
          class:list={['filter-chip', { 'is-active': view === 'project' }]}
          href={feedQuery({ view: 'project' })}
        >
          By project
        </a>
        <a
          class:list={['filter-chip', { 'is-active': view === 'user' }]}
          href={feedQuery({ view: 'user' })}
        >
          By person
        </a>
      </div>

      <div class="filter-row">
        <span class="filter-label">Activity</span>
        <a
          class:list={['filter-chip', { 'is-active': selectedKinds.size === 0 }]}
          href={kindHref(null)}
        >
          All <span class="filter-count">{plainNumber(allActivities.length)}</span>
        </a>
        <a
          class:list={['filter-chip', { 'is-active': selectedKinds.has('push') }]}
          href={kindHref('push')}
        >
          Pushes <span class="filter-count">{plainNumber(kindCounts.push)}</span>
        </a>
        <a
          class:list={['filter-chip', { 'is-active': selectedKinds.has('pull') }]}
          href={kindHref('pull')}
        >
          Pull requests <span class="filter-count">{plainNumber(kindCounts.pull)}</span>
        </a>
        <a
          class:list={['filter-chip', { 'is-active': selectedKinds.has('issue') }]}
          href={kindHref('issue')}
        >
          Issues <span class="filter-count">{plainNumber(kindCounts.issue)}</span>
        </a>
      </div>

      {availableLabels.length > 0 && (
        <div class="filter-row">
          <span class="filter-label">Issue labels</span>
          {availableLabels.map((label) => (
            <a
              class:list={['filter-chip', { 'is-active': selectedLabels.has(label) }]}
              href={labelHref(label)}
            >
              {label} <span class="filter-count">{plainNumber(labelCounts.get(label) ?? 0)}</span>
            </a>
          ))}
        </div>
      )}
    </section>
  )}

  <div class="section-head">
    <h2 class="section-title" data-feed-heading tabindex="-1">
      {activeOwner ? `Activity from ${activeOwner}` : 'Latest activity'}
    </h2>
    <span class="section-note" data-feed-summary>
      {activitySummary}
      {truncated && ` · showing ${plainNumber(visibleActivities.length)}`}
      {latestActivity && ` · latest ${relativeTime(latestActivity.timestamp)}`}
    </span>
  </div>

  {repos.length > 0 && activities.length > 0 ? (
    <ActivityFeed activities={visibleActivities} view={view} />
  ) : repos.length > 0 && allActivities.length > 0 ? (
    <EmptyState
      title="No activity matches these filters"
      text="Try widening the activity type or issue label filters to see more of the feed."
      icon="filter"
    >
      <a class="btn" href={feedQuery({ kinds: [], labels: [] })}>Clear filters</a>
    </EmptyState>
  ) : repos.length > 0 ? (
    <EmptyState
      title="No activity captured yet"
      text="The latest snapshots have no pushes, pull requests or issues to show. Sync the repositories to refresh them."
      icon="clock"
    >
      <form method="POST" action="/api/sync">
        <button class="btn btn-primary" type="submit">
          <Icon name="refresh" size={15} /> Sync all
        </button>
      </form>
    </EmptyState>
  ) : ownerFilter ? (
    <EmptyState
      title={`No repositories tracked for ${activeOwner}`}
      text="The owner filter matched nothing. Clear it to see all tracked repositories and their activity."
      icon="users"
    >
      <a class="btn" href="/">Clear filter</a>
    </EmptyState>
  ) : (
    <EmptyState
      title="Nothing tracked yet"
      text="Add a public GitHub repository above. gitsion will fetch its latest activity, pull request, tags and open issues, then keep the snapshot fresh in the background."
      icon="repo"
    >
      <form method="POST" action="/api/track">
        <input type="hidden" name="repository" value="withastro/astro" />
        <button class="btn btn-primary" type="submit">
          <Icon name="plus" size={15} /> Track withastro/astro
        </button>
      </form>
    </EmptyState>
  )}

  {activities.length > FEED_PAGE_SIZE && (
    <div class="feed-more">
      {showAll ? (
        <a class="btn btn-ghost" href={feedQuery({ showAll: false })}>
          Show latest {plainNumber(FEED_PAGE_SIZE)}
        </a>
      ) : (
        <a class="btn" href={feedQuery({ showAll: true })}>
          Show all {plainNumber(activities.length)} activities
        </a>
      )}
    </div>
  )}
  </div>

  <p id="feed-announcer" class="visually-hidden" aria-live="polite" aria-atomic="true"></p>

  <script src="/feed.js" defer></script>
</Layout>
