---
import Layout from '../layouts/Layout.astro';
import ActivityFeed from '../components/ActivityFeed.astro';
import AddRepoForm from '../components/AddRepoForm.astro';
import EmptyState from '../components/EmptyState.astro';
import Flash from '../components/Flash.astro';
import Icon from '../components/Icon.astro';
import OwnerChips from '../components/OwnerChips.astro';
import StatCard from '../components/StatCard.astro';
import { buildActivityFeed, FEED_PAGE_SIZE } from '../lib/activity';
import { ApiError, listOwners, listRepositories } from '../lib/backend';
import { plainNumber, relativeTime } from '../lib/format';
import type { OwnerSummary, Repository } from '../lib/types';

const ownerFilter = (Astro.url.searchParams.get('owner') ?? '').trim();
const okMessage = Astro.url.searchParams.get('ok');
const errorMessage = Astro.url.searchParams.get('error');
const showAll = Astro.url.searchParams.get('show') === 'all';

let repos: Repository[] = [];
let owners: OwnerSummary[] = [];
let loadError = '';

try {
  [repos, owners] = await Promise.all([
    listRepositories(ownerFilter || undefined),
    listOwners(),
  ]);
} catch (error) {
  loadError =
    error instanceof ApiError
      ? error.message
      : 'Could not reach the gitsion backend.';
}

const totalIssues = repos.reduce((total, repo) => total + repo.issues.length, 0);
const openLatestPrs = repos.filter(
  (repo) => repo.latestPr?.state === 'open' && !repo.latestPr.draft,
).length;
const lastSync = repos.reduce<string>((latest, repo) => {
  if (!repo.lastSyncedAt) return latest;
  if (!latest) return repo.lastSyncedAt;
  return new Date(repo.lastSyncedAt) > new Date(latest) ? repo.lastSyncedAt : latest;
}, '');
const activeOwner =
  owners.find((owner) => owner.login.toLowerCase() === ownerFilter.toLowerCase())?.login ??
  ownerFilter;
const totalTracked = owners.reduce((total, owner) => total + owner.repoCount, 0);

const activities = buildActivityFeed(repos);
const visibleActivities = showAll ? activities : activities.slice(0, FEED_PAGE_SIZE);
const truncated = !showAll && activities.length > FEED_PAGE_SIZE;
const latestActivity = activities[0];

function feedHref(all: boolean): string {
  const params = new URLSearchParams();
  if (ownerFilter) params.set('owner', ownerFilter);
  if (all) params.set('show', 'all');
  const query = params.toString();
  return query ? `/?${query}` : '/';
}
---

<Layout>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">
        <Icon name="commit" size={13} /> Activity feed
      </p>
      <h1>
        Everything that moved,<br />
        <em>newest first.</em>
      </h1>
      <p class="lede">
        Pushes, pull requests and issues from the repositories you track, gathered into one
        calm feed. Data is pulled from the public GitHub API and cached in MongoDB.
      </p>
    </div>
    <div class="hero-aside">
      <AddRepoForm />
    </div>
  </section>

  {okMessage && <Flash kind="success" message={okMessage} />}
  {errorMessage && <Flash kind="error" message={errorMessage} />}

  {loadError && (
    <div class="banner" role="alert">
      <Icon name="alert" size={18} />
      <div>
        <strong>Could not load the dashboard</strong>
        <p>{loadError}</p>
      </div>
    </div>
  )}

  <section class="stats" aria-label="Dashboard summary">
    <StatCard
      label="Activities"
      value={plainNumber(activities.length)}
      hint="pushes, pull requests & issues"
      icon="commit"
    />
    <StatCard
      label="Repositories"
      value={plainNumber(repos.length)}
      hint={
        ownerFilter
          ? `filtered by ${activeOwner}`
          : lastSync
            ? `last sync ${relativeTime(lastSync)}`
            : 'tracked repositories'
      }
      icon="repo"
    />
    <StatCard
      label="Open issues"
      value={plainNumber(totalIssues)}
      hint="up to 25 per repository"
      icon="issue"
    />
    <StatCard
      label="Repos with open PR"
      value={plainNumber(openLatestPrs)}
      hint="latest PR per repository"
      icon="pull"
    />
  </section>

  <OwnerChips owners={owners} activeOwner={activeOwner} total={totalTracked} />

  <div class="section-head">
    <h2 class="section-title">
      {activeOwner ? `Activity from ${activeOwner}` : 'Latest activity'}
    </h2>
    <span class="section-note">
      {plainNumber(activities.length)} {activities.length === 1 ? 'activity' : 'activities'}
      {truncated && ` · showing ${plainNumber(visibleActivities.length)}`}
      {latestActivity && ` · latest ${relativeTime(latestActivity.timestamp)}`}
    </span>
  </div>

  {repos.length > 0 && activities.length > 0 ? (
    <ActivityFeed activities={visibleActivities} />
  ) : repos.length > 0 ? (
    <EmptyState
      title="No activity captured yet"
      text="The latest snapshots have no pushes, pull requests or issues to show. Sync the repositories to refresh them."
      icon="clock"
    >
      <form method="POST" action="/api/sync">
        <button class="btn btn-primary" type="submit">
          <Icon name="refresh" size={15} /> Sync all
        </button>
      </form>
    </EmptyState>
  ) : ownerFilter ? (
    <EmptyState
      title={`No repositories tracked for ${activeOwner}`}
      text="The owner filter matched nothing. Clear it to see all tracked repositories and their activity."
      icon="users"
    >
      <a class="btn" href="/">Clear filter</a>
    </EmptyState>
  ) : (
    <EmptyState
      title="Nothing tracked yet"
      text="Add a public GitHub repository above. gitsion will fetch its latest activity, pull request, tags and open issues, then keep the snapshot fresh in the background."
      icon="repo"
    >
      <form method="POST" action="/api/track">
        <input type="hidden" name="repository" value="withastro/astro" />
        <button class="btn btn-primary" type="submit">
          <Icon name="plus" size={15} /> Track withastro/astro
        </button>
      </form>
    </EmptyState>
  )}

  {activities.length > FEED_PAGE_SIZE && (
    <div class="feed-more">
      {showAll ? (
        <a class="btn btn-ghost" href={feedHref(false)}>
          Show latest {plainNumber(FEED_PAGE_SIZE)}
        </a>
      ) : (
        <a class="btn" href={feedHref(true)}>
          Show all {plainNumber(activities.length)} activities
        </a>
      )}
    </div>
  )}
</Layout>
