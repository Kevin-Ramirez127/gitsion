# Copy to .env and adjust. Everything is optional: the dashboard is public and
# works against public GitHub repositories without a token.

# Optional: a fine-grained PAT raises the GitHub rate limit from 60 to 5,000
# requests/hour and allows tracking private repositories.
GITHUB_TOKEN=

# GitHub API endpoint (change for GitHub Enterprise).
GITHUB_API_URL=https://api.github.com

# Leave empty to use the smart default: 30m without a token, 15m with one.
# SYNC_INTERVAL=15m
SYNC_CONCURRENCY=3

# Backend
MONGODB_DB=gitsion
LOG_LEVEL=info

# Frontend
FRONTEND_PORT=4321
