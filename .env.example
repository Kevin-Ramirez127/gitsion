# Copy to .env and adjust. The dashboard is public and works against public
# GitHub repositories without a token. Leave ADMIN_TOKEN empty for read-only
# mode, or generate one to enable adding/removing repositories:
#
#   openssl rand -base64 48
#
ADMIN_TOKEN=

# Optional cookie-signing key for the admin session. Rotating it signs out every
# admin. Sessions are also bound to ADMIN_TOKEN, so rotating the token signs
# them out too. When empty, this key is derived from ADMIN_TOKEN.
#   openssl rand -base64 48
SESSION_SECRET=

# Optional: a fine-grained PAT raises the GitHub rate limit from 60 to 5,000
# requests/hour. Private repositories are never tracked, even with a token.
GITHUB_TOKEN=

# GitHub API endpoint (change for GitHub Enterprise).
GITHUB_API_URL=https://api.github.com

# Leave empty to use the smart default: 30m without a token, 15m with one.
# SYNC_INTERVAL=15m
SYNC_CONCURRENCY=3

# Backend
MONGODB_DB=gitsion
LOG_LEVEL=info

# Frontend
FRONTEND_PORT=4321

# Branding (optional). SITE_NAME appears in the header, footer and page titles.
SITE_NAME=gitsion
SITE_TAGLINE=GitHub activity feed
# SITE_TITLE defaults to "<SITE_NAME> · <SITE_TAGLINE>" when empty.
# SITE_TITLE=
# SITE_DESCRIPTION defaults to the built-in feed description when empty.
# SITE_DESCRIPTION=

# SEO (optional). Set SITE_URL in production so canonical links, robots.txt and
# sitemap.xml use the public origin instead of the request host (which may be an
# internal container or reverse-proxy address).
# SITE_URL=https://gitsion.example.com
# Absolute social preview image (1200x630 recommended). Defaults to /og.png.
# SITE_OG_IMAGE=
# Optional Twitter/X handle for twitter:site, including the leading @.
# SITE_TWITTER=

# Visible dashboard headline and intro. In HERO_TITLE, the part after "|" is
# rendered on a second line in the accent color.
# HERO_TITLE=Everything that moved,|newest first.
# HERO_DESCRIPTION=Pushes, pull requests and issues from the repositories you track, gathered into one calm, readable feed.

# Theme colors (optional). Set THEME_<TOKEN> to change both themes, or
# THEME_DARK_<TOKEN> / THEME_LIGHT_<TOKEN> to change one theme only.
# Tokens: BG, PANEL, PANEL_2, PANEL_HOVER, BORDER, RULE_SOFT, TEXT, MUTED,
# FAINT, ACCENT, ACCENT_SOFT, ON_STRONG, ON_ACCENT, PLACEHOLDER.
# Examples:
# THEME_ACCENT=#2563eb
# THEME_DARK_BG=#000000
# THEME_LIGHT_BG=#ffffff
