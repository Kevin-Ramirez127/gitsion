# Copy to deploy/vps/.env on the VPS and fill in the secrets.
# The same ADMIN_TOKEN must be set as a Cloudflare Worker secret.

# Required. openssl rand -base64 48
ADMIN_TOKEN=

# Optional fine-grained PAT (raises GitHub 60 -> 5000 requests/hour).
GITHUB_TOKEN=

MONGODB_DB=gitsion
GITHUB_API_URL=https://api.github.com

# Leave empty for the default: 30m without GITHUB_TOKEN, 15m with one.
# SYNC_INTERVAL=15m
SYNC_CONCURRENCY=3
LOG_LEVEL=info
