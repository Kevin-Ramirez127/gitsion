#!/usr/bin/env node
'use strict';

// Bulk-import GitHub repositories into gitsion. The script lists a user or
// organization profile through the GitHub API, then tracks the selected
// repositories through the existing gitsion backend API.

const fs = require('node:fs');
const path = require('node:path');
const readline = require('node:readline/promises');

const DEFAULT_GITHUB_API_URL = 'https://api.github.com';
const DEFAULT_BACKEND_URL = 'http://localhost:8080';
const USER_AGENT = 'gitsion-import/1.0';
const LOGIN_PATTERN = /^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$/;
const PATH_PART_PATTERN = /^[A-Za-z0-9_.-]+$/;
const GITHUB_TIMEOUT_MS = 30_000;
const BACKEND_TIMEOUT_MS = 15_000;
const TRACK_TIMEOUT_MS = 60_000;

class UsageError extends Error {
  constructor(message) {
    super(message);
    this.name = 'UsageError';
  }
}

class GitHubError extends Error {
  constructor(status, message, options = {}) {
    super(message);
    this.name = 'GitHubError';
    this.status = status;
    this.rateLimited = options.rateLimited === true;
    this.resetAt = options.resetAt || null;
  }
}

class BackendError extends Error {
  constructor(message, code = '', options = {}) {
    super(message);
    this.name = 'BackendError';
    this.code = code;
    this.network = options.network === true;
  }
}

const useColor =
  Boolean(process.stdout.isTTY) && !Object.prototype.hasOwnProperty.call(process.env, 'NO_COLOR');
const color = (code) => (text) => (useColor ? `\x1b[${code}m${text}\x1b[0m` : String(text));
const c = {
  bold: color('1'),
  dim: color('2'),
  green: color('32'),
  yellow: color('33'),
  red: color('31'),
};

async function main() {
  loadDotEnv('.env');
  loadDotEnv(path.join('..', '.env'));

  const options = parseArgs(process.argv.slice(2));
  if (options.help) {
    printHelp();
    return 0;
  }

  const config = {
    githubApiURL: (process.env.GITHUB_API_URL || DEFAULT_GITHUB_API_URL).replace(/\/+$/, ''),
    githubToken: (process.env.GITHUB_TOKEN || '').trim(),
    adminToken: (process.env.ADMIN_TOKEN || '').trim(),
    backendURL: (process.env.BACKEND_URL || DEFAULT_BACKEND_URL).replace(/\/+$/, ''),
  };

  if (!options.dryRun && !config.adminToken) {
    throw new UsageError(
      'ADMIN_TOKEN is required to import repositories. Set it in the environment or .env.',
    );
  }

  let repos;
  let source;
  if (options.json) {
    repos = loadReposFromJSON(options.json);
    source = isInlineJSON(options.json) ? 'inline JSON' : `JSON file ${options.json}`;
  } else {
    if (!config.githubToken) {
      console.log(c.dim('No GITHUB_TOKEN set: only public repositories will be listed.'));
    }
    const login = parseProfileInput(options.profile);
    console.log(c.dim(`Fetching repositories for ${login} from ${config.githubApiURL}...`));
    const profile = await fetchProfile(login, config);
    repos = profile.repos;
    source = `${profile.login} (${profile.type})`;
  }

  if (repos.length === 0) {
    console.log(`No repositories found in ${source}.`);
    return 0;
  }

  const publicRepos = repos.filter(isPublicRepo);
  if (publicRepos.length !== repos.length) {
    const skipped = repos.length - publicRepos.length;
    console.log(
      c.dim(
        `Skipping ${skipped} private or internal repositor${skipped === 1 ? 'y' : 'ies'}: gitsion only tracks public repositories.`,
      ),
    );
    repos = publicRepos;
  }

  if (repos.length === 0) {
    console.log('No public repositories to import.');
    return 0;
  }

  let tracked = new Set();
  try {
    tracked = await loadTrackedSet(config.backendURL);
  } catch (error) {
    if (!options.dryRun) throw error;
    console.error(c.dim(`Note: ${error.message} Tracked markers are unavailable.`));
  }

  printRepoTable(repos, tracked, source);

  if (!options.dryRun && repos.every((repo) => tracked.has(repo.fullName.toLowerCase()))) {
    console.log('All listed repositories are already tracked.');
    return 0;
  }

  if (options.dryRun && !options.all && options.select === null) {
    console.log(
      `Dry run: ${repos.length} repositor${repos.length === 1 ? 'y' : 'ies'} available to import.`,
    );
    return 0;
  }

  let selected;
  if (options.all) {
    selected = repos;
  } else if (options.select !== null) {
    selected = parseSelection(repos, options.select);
  } else {
    selected = await promptSelection(repos);
  }

  if (selected.length === 0) {
    console.log('Nothing selected.');
    return 0;
  }

  if (options.dryRun) {
    console.log(
      `Dry run: would import ${selected.length} repositor${selected.length === 1 ? 'y' : 'ies'}.`,
    );
    return 0;
  }

  const summary = { imported: 0, skipped: 0, failed: 0 };
  for (let index = 0; index < selected.length; index += 1) {
    const repo = selected[index];
    const label = `[${index + 1}/${selected.length}] ${repo.fullName}`;

    if (tracked.has(repo.fullName.toLowerCase())) {
      console.log(`${c.dim('skip')}   ${label} (already tracked)`);
      summary.skipped += 1;
      continue;
    }

    try {
      await trackRepository(config.backendURL, repo, config.adminToken);
      tracked.add(repo.fullName.toLowerCase());
      console.log(`${c.green('import')} ${label}`);
      summary.imported += 1;
    } catch (error) {
      if (error.code === 'already_tracked') {
        tracked.add(repo.fullName.toLowerCase());
        console.log(`${c.dim('skip')}   ${label} (already tracked)`);
        summary.skipped += 1;
        continue;
      }

      const reason = error instanceof Error ? error.message : String(error);
      console.error(`${c.red('failed')} ${label}: ${reason}`);
      summary.failed += 1;

      if (
        error.code === 'github_rate_limited' ||
        error.code === 'github_auth_failed' ||
        error.network
      ) {
        console.error('Stopping because the backend cannot continue.');
        break;
      }
    }
  }

  const parts = [`${summary.imported} imported`, `${summary.skipped} skipped`];
  if (summary.failed > 0) parts.push(`${summary.failed} failed`);
  console.log(`\nDone: ${parts.join(', ')}.`);
  return summary.failed > 0 ? 1 : 0;
}

function parseArgs(argv) {
  const options = {
    profile: null,
    json: null,
    all: false,
    select: null,
    dryRun: false,
    help: false,
  };
  const positional = [];

  for (let index = 0; index < argv.length; index += 1) {
    const arg = argv[index];
    if (arg === '--') {
      positional.push(...argv.slice(index + 1));
      break;
    }
    if (arg === '-h' || arg === '--help') {
      options.help = true;
      continue;
    }
    if (arg === '-a' || arg === '--all') {
      options.all = true;
      continue;
    }
    if (arg === '-n' || arg === '--dry-run') {
      options.dryRun = true;
      continue;
    }

    const inline = arg.match(/^(--[a-z-]+)=(.*)$/);
    const name = inline ? inline[1] : arg;
    if (name === '-j' || name === '--json' || name === '-s' || name === '--select') {
      let value = inline ? inline[2] : undefined;
      if (value === undefined) {
        index += 1;
        value = argv[index];
      }
      if (value === undefined || value === '') {
        throw new UsageError(`${name} requires a value.`);
      }
      if (name === '-j' || name === '--json') {
        if (options.json !== null) throw new UsageError('--json was provided more than once.');
        options.json = value;
      } else {
        if (options.select !== null) throw new UsageError('--select was provided more than once.');
        options.select = value;
      }
      continue;
    }

    if (arg.startsWith('-')) throw new UsageError(`Unknown option ${arg}.`);
    positional.push(arg);
  }

  if (positional.length > 1) {
    throw new UsageError('Provide only one profile link, login or JSON file.');
  }
  if (positional.length === 1) {
    const value = positional[0].trim();
    if (options.json === null && (isInlineJSON(value) || /\.json$/i.test(value))) {
      options.json = value;
    } else {
      options.profile = value;
    }
  }

  if (options.help) return options;
  if (options.profile && options.json) {
    throw new UsageError('Provide either a profile link/login or --json, not both.');
  }
  if (options.profile === null && options.json === null) {
    throw new UsageError('Provide a GitHub organization/user profile link, or --json <file|json>.');
  }
  if (options.all && options.select !== null) {
    throw new UsageError('Use either --all or --select, not both.');
  }
  return options;
}

function printHelp() {
  console.log(`Usage:
  ./import <profile> [options]
  ./import <repositories.json> [options]
  ./import --json <file|json> [options]

Import GitHub repositories into gitsion.

Arguments:
  <profile>              GitHub organization/user profile URL or login
                         (for example https://github.com/withastro or @withastro)
  <repositories.json>    A positional argument ending in .json is read as JSON

Options:
  -j, --json <file|json> Read repositories from a JSON file or inline array
  -a, --all              Import every repository without prompting
  -s, --select <list>    Import only these numbers/ranges (for example 1,3-5)
  -n, --dry-run          Show the repositories without importing them
  -h, --help             Show this help

Environment:
  BACKEND_URL            gitsion API (default: http://localhost:8080)
  GITHUB_TOKEN           Optional token for higher rate limits (private repos are skipped)
  GITHUB_API_URL         GitHub API (default: https://api.github.com)
  ADMIN_TOKEN            Required to import repositories (gitsion admin token)

A .env file in the current directory (or its parent) is loaded automatically.
The JSON input can be an array of repository strings or GitHub-like objects:

  ["withastro/astro", {"full_name": "withastro/starlight"}]`);
}

function parseProfileInput(raw) {
  let input = String(raw).trim();
  if (input === '') throw new UsageError('Profile link or login is empty.');

  const looksLikeURL = /^[a-z][a-z0-9+.-]*:\/\//i.test(input) || /^(?:www\.)?github\.com\//i.test(input);
  if (looksLikeURL) {
    const urlInput = /^[a-z][a-z0-9+.-]*:\/\//i.test(input) ? input : `https://${input}`;
    let parsed;
    try {
      parsed = new URL(urlInput);
    } catch {
      throw new UsageError(`"${raw}" is not a valid profile URL.`);
    }

    const parts = parsed.pathname.split('/').filter(Boolean);
    if (parts.length === 1) {
      input = parts[0];
    } else if (parts.length === 2 && parts[0].toLowerCase() === 'orgs') {
      input = parts[1];
    } else if (
      parts.length === 3 &&
      parts[0].toLowerCase() === 'orgs' &&
      parts[2].toLowerCase() === 'repositories'
    ) {
      input = parts[1];
    } else {
      throw new UsageError(
        `Expected a profile URL like https://github.com/withastro or ` +
          `https://github.com/orgs/withastro, got ${raw}.`,
      );
    }
  } else {
    input = input.replace(/^@/, '');
    if (input.includes('/')) {
      throw new UsageError(
        `"${raw}" looks like a repository. Pass a profile link or an owner login instead.`,
      );
    }
  }

  try {
    input = decodeURIComponent(input);
  } catch {
    throw new UsageError(`"${raw}" contains invalid URL encoding.`);
  }

  if (!LOGIN_PATTERN.test(input)) {
    throw new UsageError(`"${raw}" is not a valid GitHub user or organization.`);
  }
  return input;
}

async function fetchProfile(login, config) {
  const response = await githubRequest(
    `${config.githubApiURL}/users/${encodeURIComponent(login)}`,
    config,
  );
  const user = response.data;
  if (!user || typeof user.login !== 'string') {
    throw new GitHubError(0, `GitHub returned no profile for ${login}.`);
  }

  const kind = user.type === 'Organization' ? 'orgs' : 'users';
  const basePath = `/${kind}/${encodeURIComponent(user.login)}/repos`;
  const repos = await fetchAllRepos(basePath, config);
  return {
    login: user.login,
    type: user.type === 'Organization' ? 'Organization' : 'User',
    repos,
  };
}

async function fetchAllRepos(basePath, config) {
  const repos = [];
  let url =
    `${config.githubApiURL}${basePath}` +
    '?per_page=100&sort=updated&direction=desc&type=all';

  while (url) {
    const response = await githubRequest(url, config);
    if (!Array.isArray(response.data)) {
      throw new GitHubError(0, 'GitHub returned an unexpected repository list.');
    }
    for (const raw of response.data) {
      const repo = mapGitHubRepo(raw);
      if (repo) repos.push(repo);
    }
    url = nextPageURL(response.link);
  }
  return repos;
}

async function githubRequest(url, config) {
  let response;
  try {
    response = await fetch(url, {
      headers: {
        Accept: 'application/vnd.github+json',
        'X-GitHub-Api-Version': '2022-11-28',
        'User-Agent': USER_AGENT,
        ...(config.githubToken ? { Authorization: `Bearer ${config.githubToken}` } : {}),
      },
      signal: AbortSignal.timeout(GITHUB_TIMEOUT_MS),
    });
  } catch (error) {
    const reason = error instanceof Error ? error.message : String(error);
    throw new GitHubError(0, `Could not reach GitHub at ${config.githubApiURL}: ${reason}`);
  }

  const payload = await readJSON(response);
  if (!response.ok) throw describeGitHubError(response, payload);
  return { data: payload, link: response.headers.get('link') };
}

function describeGitHubError(response, payload) {
  const apiMessage =
    payload && typeof payload.message === 'string' ? payload.message : '';
  const remaining = response.headers.get('x-ratelimit-remaining');
  const resetUnix = Number(response.headers.get('x-ratelimit-reset'));
  const resetAt =
    Number.isFinite(resetUnix) && resetUnix > 0 ? new Date(resetUnix * 1000) : null;
  const rateLimited =
    (response.status === 403 || response.status === 429) &&
    (remaining === '0' || response.status === 429);

  if (rateLimited) {
    const when = resetAt ? ` until ${resetAt.toLocaleString()}` : '';
    return new GitHubError(
      response.status,
      `GitHub API rate limit exceeded${when}. Set GITHUB_TOKEN or retry later.`,
      { rateLimited, resetAt },
    );
  }
  if (response.status === 404) {
    return new GitHubError(
      404,
      `GitHub returned 404${apiMessage ? `: ${apiMessage}` : ''}. ` +
        'Check the profile login and GITHUB_TOKEN permissions.',
    );
  }
  if (response.status === 401) {
    return new GitHubError(401, 'GitHub rejected GITHUB_TOKEN. Check the token and try again.');
  }
  return new GitHubError(
    response.status,
    `GitHub API returned ${response.status}${apiMessage ? `: ${apiMessage}` : ''}.`,
  );
}

function nextPageURL(linkHeader) {
  if (!linkHeader) return null;
  for (const part of linkHeader.split(',')) {
    const match = part.match(/<([^>]+)>\s*;\s*rel="next"/);
    if (match) return match[1];
  }
  return null;
}

function mapGitHubRepo(raw) {
  if (!raw || typeof raw !== 'object' || typeof raw.full_name !== 'string') return null;
  const [owner, name] = raw.full_name.split('/');
  return {
    fullName: raw.full_name,
    owner: raw.owner && raw.owner.login ? raw.owner.login : owner,
    name: raw.name || name,
    htmlUrl: typeof raw.html_url === 'string' ? raw.html_url : '',
    description: typeof raw.description === 'string' ? raw.description : '',
    stars: Number.isFinite(raw.stargazers_count) ? raw.stargazers_count : 0,
    language: typeof raw.language === 'string' ? raw.language : '',
    updatedAt: raw.updated_at || raw.pushed_at || '',
    private: raw.private === true,
    visibility:
      typeof raw.visibility === 'string' ? raw.visibility : raw.private === true ? 'private' : 'public',
    fork: raw.fork === true,
    archived: raw.archived === true,
  };
}

function loadReposFromJSON(source) {
  const inline = isInlineJSON(source);
  const label = inline ? 'inline JSON' : source;
  let text;
  if (inline) {
    text = source;
  } else {
    try {
      text = fs.readFileSync(path.resolve(source), 'utf8');
    } catch (error) {
      const reason = error instanceof Error ? error.message : String(error);
      throw new UsageError(`Could not read ${label}: ${reason}`);
    }
  }

  let parsed;
  try {
    parsed = JSON.parse(text.replace(/^\uFEFF/, ''));
  } catch (error) {
    const reason = error instanceof Error ? error.message : String(error);
    throw new UsageError(`${label} is not valid JSON: ${reason}`);
  }

  let list;
  if (Array.isArray(parsed)) list = parsed;
  else if (parsed && Array.isArray(parsed.repositories)) list = parsed.repositories;
  else if (parsed && Array.isArray(parsed.repos)) list = parsed.repos;
  else {
    throw new UsageError(
      `${label} must contain an array of repositories ` +
        '(or an object with a "repositories" array).',
    );
  }

  if (list.length === 0) throw new UsageError(`${label} does not contain any repositories.`);

  const repos = [];
  const seen = new Set();
  const skipped = [];
  list.forEach((entry, index) => {
    const repo = repoFromJSONEntry(entry);
    if (!repo) {
      skipped.push(`#${index + 1} (not a repository)`);
      return;
    }
    const key = repo.fullName.toLowerCase();
    if (seen.has(key)) {
      skipped.push(`#${index + 1} (duplicate)`);
      return;
    }
    seen.add(key);
    repos.push(repo);
  });

  if (skipped.length > 0) {
    console.warn(
      `Skipped ${skipped.length} entr${skipped.length === 1 ? 'y' : 'ies'} in ${label}: ` +
        skipped.join(', '),
    );
  }
  if (repos.length === 0) {
    throw new UsageError(`None of the entries in ${label} could be parsed as repositories.`);
  }
  return repos;
}

function isInlineJSON(value) {
  const text = String(value).trim();
  return text.startsWith('[') || text.startsWith('{');
}

function repoFromJSONEntry(entry) {
  if (typeof entry === 'string') {
    const ref = parseRepoRef(entry);
    return ref ? repoFromRef(ref) : null;
  }
  if (!entry || typeof entry !== 'object' || Array.isArray(entry)) return null;

  const direct = firstString(
    entry.full_name,
    entry.fullName,
    entry.name_with_owner,
    entry.nameWithOwner,
    entry.repository,
    entry.repo,
    entry.name,
  );
  let ref = direct ? parseRepoRef(direct) : null;

  if (!ref) {
    const url = firstString(entry.html_url, entry.htmlUrl, entry.url, entry.clone_url, entry.ssh_url);
    if (url) ref = parseRepoRef(url);
  }
  if (!ref) {
    const owner =
      typeof entry.owner === 'string'
        ? entry.owner
        : entry.owner && typeof entry.owner === 'object'
          ? firstString(entry.owner.login, entry.owner.name)
          : '';
    const name = firstString(entry.name, entry.repo);
    if (owner && name) ref = parseRepoRef(`${owner}/${name}`);
  }
  if (!ref) return null;

  const repo = repoFromRef(ref);
  repo.description = firstString(entry.description);
  repo.htmlUrl = firstString(entry.html_url, entry.htmlUrl) || repo.htmlUrl;
  repo.stars = firstNumber(entry.stargazers_count, entry.stars, entry.stargazers);
  repo.language = firstString(entry.language);
  repo.updatedAt = firstString(entry.updated_at, entry.updatedAt, entry.pushed_at, entry.pushedAt);
  repo.private = entry.private === true;
  repo.visibility = firstString(entry.visibility) || (repo.private ? 'private' : '');
  repo.fork = entry.fork === true;
  repo.archived = entry.archived === true;
  return repo;
}

function repoFromRef(ref) {
  return {
    fullName: `${ref.owner}/${ref.name}`,
    owner: ref.owner,
    name: ref.name,
    htmlUrl: '',
    description: '',
    stars: null,
    language: '',
    updatedAt: '',
    private: false,
    visibility: '',
    fork: false,
    archived: false,
  };
}

function isPublicRepo(repo) {
  if (repo.private === true) return false;
  const visibility = String(repo.visibility || '').trim().toLowerCase();
  return visibility === '' || visibility === 'public';
}

function parseRepoRef(raw) {
  if (typeof raw !== 'string') return null;
  let input = raw.trim();
  if (input === '') return null;

  if (input.startsWith('git@')) {
    const separator = input.search(/[:/]/);
    if (separator < 0) return null;
    input = input.slice(separator + 1);
  } else if (/^[a-z][a-z0-9+.-]*:\/\//i.test(input)) {
    let parsed;
    try {
      parsed = new URL(input);
    } catch {
      return null;
    }
    input = parsed.pathname;
  } else {
    input = input.replace(/^(?:www\.)?github\.com\//i, '');
  }

  try {
    input = decodeURIComponent(input);
  } catch {
    return null;
  }
  input = input
    .replace(/^\/+|\/+$/g, '')
    .replace(/\.git$/i, '')
    .replace(/^(?:api\/v\d+\/)?repos\//i, '');
  const parts = input.split('/').filter(Boolean);
  if (parts.length !== 2) return null;

  const [owner, name] = parts;
  if (!validPathPart(owner) || !validPathPart(name)) return null;
  return { owner, name };
}

function validPathPart(part) {
  if (part === '' || part === '.' || part === '..') return false;
  return PATH_PART_PATTERN.test(part);
}

function firstString(...values) {
  for (const value of values) {
    if (typeof value === 'string' && value.trim() !== '') return value.trim();
  }
  return '';
}

function firstNumber(...values) {
  for (const value of values) {
    if (value === null || value === undefined || value === '') continue;
    const number = Number(value);
    if (Number.isFinite(number) && number >= 0) return number;
  }
  return null;
}

async function loadTrackedSet(backendURL) {
  let response;
  try {
    response = await fetch(`${backendURL}/api/v1/repos`, {
      headers: { Accept: 'application/json' },
      signal: AbortSignal.timeout(BACKEND_TIMEOUT_MS),
    });
  } catch (error) {
    const reason = error instanceof Error ? error.message : String(error);
    throw new BackendError(
      `Could not reach the gitsion API at ${backendURL}. Is the backend running? (${reason})`,
      'network_error',
      { network: true },
    );
  }

  const payload = await readJSON(response);
  if (!response.ok) {
    const envelope = payload && payload.error ? payload.error : {};
    throw new BackendError(
      envelope.message || `gitsion API returned ${response.status}`,
      envelope.code || 'unknown_error',
    );
  }

  const repositories = payload && Array.isArray(payload.repositories) ? payload.repositories : [];
  const tracked = new Set();
  for (const repo of repositories) {
    const fullName =
      repo && typeof repo.fullName === 'string'
        ? repo.fullName
        : repo && repo.owner && repo.name
          ? `${repo.owner.login}/${repo.name}`
          : '';
    if (fullName) tracked.add(fullName.toLowerCase());
  }
  return tracked;
}

async function trackRepository(backendURL, repo, adminToken) {
  let response;
  try {
    response = await fetch(`${backendURL}/api/v1/repos`, {
      method: 'POST',
      headers: {
        Accept: 'application/json',
        'Content-Type': 'application/json',
        ...(adminToken ? { Authorization: `Bearer ${adminToken}` } : {}),
      },
      body: JSON.stringify({ repository: repo.fullName }),
      signal: AbortSignal.timeout(TRACK_TIMEOUT_MS),
    });
  } catch (error) {
    const reason = error instanceof Error ? error.message : String(error);
    throw new BackendError(
      `Could not reach the gitsion API at ${backendURL}. Is the backend running? (${reason})`,
      'network_error',
      { network: true },
    );
  }

  const payload = await readJSON(response);
  if (response.ok) return payload;

  const envelope = payload && payload.error ? payload.error : {};
  throw new BackendError(
    envelope.message || `gitsion API returned ${response.status}`,
    envelope.code || 'unknown_error',
  );
}

async function readJSON(response) {
  const text = await response.text();
  if (text === '') return null;
  try {
    return JSON.parse(text);
  } catch {
    return null;
  }
}

function printRepoTable(repos, tracked, source) {
  const trackedCount = repos.filter((repo) => tracked.has(repo.fullName.toLowerCase())).length;
  const countLabel = `${repos.length} repositor${repos.length === 1 ? 'y' : 'ies'}`;
  const trackedLabel = trackedCount > 0 ? `, ${trackedCount} already tracked` : '';
  console.log(`\n${c.bold('Source:')} ${source} — ${countLabel}${trackedLabel}\n`);

  const headers = ['#', 'Repository', 'Status', 'Visibility', 'Stars', 'Language', 'Updated'];
  const rows = repos.map((repo, index) => {
    const isTracked = tracked.has(repo.fullName.toLowerCase());
    return {
      isTracked,
      cells: [
        String(index + 1),
        truncate(repo.fullName, 56),
        isTracked ? 'tracked' : 'new',
        repo.visibility || (repo.private ? 'private' : '-'),
        formatCount(repo.stars),
        truncate(repo.language || '-', 16),
        formatRelative(repo.updatedAt),
      ],
    };
  });

  const widths = headers.map((header, column) =>
    rows.reduce((max, row) => Math.max(max, row.cells[column].length), header.length),
  );
  const render = (cells, styles = []) =>
    cells
      .map((cell, column) => {
        const aligned =
          column === 0 || column === 4 ? padLeft(cell, widths[column]) : padRight(cell, widths[column]);
        return styles[column] ? styles[column](aligned) : aligned;
      })
      .join('  ');

  console.log(render(headers, headers.map(() => c.bold)));
  for (const row of rows) {
    console.log(
      render(row.cells, [
        c.dim,
        null,
        row.isTracked ? c.dim : c.green,
        /private|internal/i.test(row.cells[3]) ? c.yellow : null,
        null,
        null,
        c.dim,
      ]),
    );
  }
  console.log('');
}

function padRight(value, width) {
  return `${value}${' '.repeat(Math.max(0, width - value.length))}`;
}

function padLeft(value, width) {
  return `${' '.repeat(Math.max(0, width - value.length))}${value}`;
}

function truncate(value, max) {
  const text = String(value);
  if (text.length <= max) return text;
  return `${text.slice(0, Math.max(0, max - 1))}…`;
}

function formatCount(value) {
  if (value === null || value === undefined || value === '') return '-';
  const number = Number(value);
  if (!Number.isFinite(number) || number < 0) return '-';
  if (number < 1000) return String(number);
  if (number < 1_000_000) {
    const scaled = number / 1000;
    return `${scaled % 1 === 0 ? scaled.toFixed(0) : scaled.toFixed(1)}k`;
  }
  const scaled = number / 1_000_000;
  return `${scaled % 1 === 0 ? scaled.toFixed(0) : scaled.toFixed(1)}m`;
}

function formatRelative(value) {
  if (!value) return '-';
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return '-';

  const seconds = Math.max(0, Math.floor((Date.now() - date.getTime()) / 1000));
  if (seconds < 60) return 'just now';
  const minutes = Math.floor(seconds / 60);
  if (minutes < 60) return `${minutes}m ago`;
  const hours = Math.floor(minutes / 60);
  if (hours < 24) return `${hours}h ago`;
  const days = Math.floor(hours / 24);
  if (days < 30) return `${days}d ago`;
  const months = Math.floor(days / 30);
  if (months < 12) return `${months}mo ago`;
  return `${Math.floor(months / 12)}y ago`;
}

async function promptSelection(repos) {
  if (!process.stdin.isTTY) {
    throw new UsageError(
      'Cannot prompt without a terminal. Use --all or --select to run non-interactively.',
    );
  }

  const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
  try {
    const importAll = await rl.question(
      `Import all ${repos.length} repositor${repos.length === 1 ? 'y' : 'ies'}? [y/N] `,
    );
    if (/^(?:y|yes)$/i.test(importAll.trim())) return repos;

    while (true) {
      const answer = await rl.question(
        'Select repositories (numbers/ranges like 1,3-5; "all" or "none"): ',
      );
      try {
        return parseSelection(repos, answer);
      } catch (error) {
        console.error(error instanceof Error ? error.message : String(error));
      }
    }
  } finally {
    rl.close();
  }
}

function parseSelection(repos, expression) {
  const text = String(expression || '')
    .trim()
    .toLowerCase()
    .replace(/\s*([-:])\s*/g, '$1');
  if (text === '' || text === 'none') return [];
  if (text === 'all' || text === '*') return repos;

  const indices = new Set();
  for (const token of text.split(/[\s,]+/).filter(Boolean)) {
    if (token === 'all' || token === '*') return repos;

    const range = token.match(/^(\d+)\s*[-:]\s*(\d+)$/);
    if (range) {
      const start = Number(range[1]);
      const end = Number(range[2]);
      if (start < 1 || end > repos.length || start > end) {
        throw new UsageError(
          `Invalid range "${token}". Use numbers between 1 and ${repos.length}.`,
        );
      }
      for (let index = start; index <= end; index += 1) indices.add(index);
      continue;
    }

    const number = Number(token);
    if (!Number.isInteger(number) || number < 1 || number > repos.length) {
      throw new UsageError(
        `"${token}" is not a repository number between 1 and ${repos.length}.`,
      );
    }
    indices.add(number);
  }
  return [...indices].sort((a, b) => a - b).map((index) => repos[index - 1]);
}

function loadDotEnv(file) {
  let text;
  try {
    text = fs.readFileSync(file, 'utf8');
  } catch {
    return;
  }

  for (const rawLine of text.split(/\r?\n/)) {
    let line = rawLine.trim();
    if (line === '' || line.startsWith('#')) continue;
    if (line.startsWith('export ')) line = line.slice('export '.length).trim();

    const separator = line.indexOf('=');
    if (separator <= 0) continue;
    const key = line.slice(0, separator).trim();
    let value = line.slice(separator + 1).trim();
    if (key === '') continue;
    if (
      (value.startsWith('"') && value.endsWith('"')) ||
      (value.startsWith("'") && value.endsWith("'"))
    ) {
      value = value.slice(1, -1);
    }
    if (Object.prototype.hasOwnProperty.call(process.env, key)) continue;
    process.env[key] = value;
  }
}

